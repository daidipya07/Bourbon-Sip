# Copy this file to .env.local and fill in your values
# .env.local is gitignored — never commit it

# Site URL (your Vercel deployment URL or custom domain)
NEXT_PUBLIC_SITE_URL=https://bourbonpour.vercel.app

# Mailchimp (get from mailchimp.com → Account → Extras → API Keys)
MAILCHIMP_API_KEY=your-api-key-here
MAILCHIMP_LIST_ID=your-audience-list-id
MAILCHIMP_DC=us1   # the data center prefix from your API key (e.g. us1, us21)

# Finnhub (get from finnhub.io — free tier)
FINNHUB_API_KEY=your-finnhub-api-key
